{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Answers Schema",
  "description": "An array of answers",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string"
      },
      "text": {
        "type": "string"
      },
      "image": {
        "type": "string"
      }
    },
    "required": [
      "id",
      "text"
    ],
    "additionalProperties": false
  }
}
